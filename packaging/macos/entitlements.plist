<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the hardened runtime (Developer ID signing). DAW 388 records from an audio
     input, so it needs the microphone; everything else (files, MIDI, the update check) needs no
     entitlement outside the App Store sandbox. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
